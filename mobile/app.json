{
  "expo": {
    "name": "Fuel Factor",
    "slug": "fuel-factor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fuelfactor",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a2639",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "dev.snehaa006.fuelfactor"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a2639",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fuel Factor asks for a photo only when you choose to add one to a weekly challenge. Photos stay private to your account.",
          "cameraPermission": "Fuel Factor uses the camera only when you take a photo for a weekly challenge. Photos stay private to your account."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "dev.snehaa006.fuelfactor"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "32b11a9f-9dfa-4ca6-9bae-2950fae749bd"
      }
    },
    "owner": "snehaa006"
  }
}
