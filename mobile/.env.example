# Supabase project "fuel-factor" (nprvrlpkdrgckzceyryc), ap-southeast-1 Singapore.
# EXPO_PUBLIC_ values are compiled into the app bundle. The publishable key is
# designed to be public and is useless without a session, because every table is
# protected by row level security.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
